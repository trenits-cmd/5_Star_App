rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(coupleId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // Eigenes Nutzerprofil: nur der Besitzer liest und schreibt es.
    // Eigenes Profil: Besitzer schreibt. Lesen erlaubt auch dem Partner im selben Paar (Anzeigename).
    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid
          || (resource.data.coupleId != null && isMember(resource.data.coupleId)));
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Einladungen: open -> requested (Partner fordert an) -> confirmed | declined (Einlader entscheidet).
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && isMember(request.resource.data.coupleId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'open';

      // Partner löst den Code ein (direkt auf 'confirmed' oder 'requested'). Ist eine E-Mail hinterlegt, muss sie übereinstimmen.
      allow update: if signedIn()
        && (
          (resource.data.status in ['open', 'requested']
            && request.resource.data.status in ['requested', 'confirmed']
            && request.resource.data.requestedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'requestedBy', 'requestedEmail'])
            && (resource.data.get('invitedEmail', '') == ''
              || resource.data.invitedEmail.lower() == request.auth.token.email.lower()))
          ||
          (isMember(resource.data.coupleId)
            && resource.data.status == 'requested'
            && request.resource.data.status in ['confirmed', 'declined']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        );

      // Einlader räumt auf, oder der Partner zieht seine Anfrage zurück bzw. schließt sie nach Bestätigung ab.
      allow delete: if isMember(resource.data.coupleId)
        || resource.data.get('requestedBy', '') == request.auth.uid;
    }

    match /couples/{coupleId} {
      allow read: if isMember(coupleId);

      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];

      // Beitritt: nur wenn genau ein Mitglied vorhanden ist und man sich selbst hinzufügt.
      // Zu Testzwecken darf ein Mitglied die Partner-Verbindung auch wieder auf [request.auth.uid] zurücksetzen.
      allow update: if signedIn()
        && (
          (resource.data.members.size() == 1
            && request.resource.data.members.size() == 2
            && request.auth.uid in request.resource.data.members
            && resource.data.members[0] in request.resource.data.members)
          ||
          (request.auth.uid in resource.data.members
            && request.resource.data.members == [request.auth.uid])
        );

      allow delete: if false;

      // Mitglieder lesen alles im Paar.
      match /categories/{catId} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId) && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if isMember(coupleId) && resource.data.ownerUid == request.auth.uid;
      }

      match /catalog/{itemId} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId) && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if isMember(coupleId) && resource.data.ownerUid == request.auth.uid;
      }

      // Tageseinträge: nur der Besitzer schreibt die eigenen Bewertungen.
      match /days/{dayId} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId) && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if false;
      }

      // Aufgaben: Mitglieder des Paares legen Aufgaben an, wählen den Titel aus dem Dropdown
      // und bestätigen die Einlösung (mit status = CONFIRMED und redeemedDayKey) bzw. Auto-Confirm nach 48h.
      match /tasks/{taskId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId);
        allow update: if isMember(coupleId)
          && (
            (resource.data.status == 'OPEN'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title']))
            ||
            (resource.data.status == 'OPEN'
              && request.resource.data.status == 'CONFIRMED'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'redeemedDayKey', 'title']))
            ||
            (resource.data.status == 'OPEN'
              && request.resource.data.status == 'AUTO_CONFIRMED'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'redeemedDayKey']))
          );
        allow delete: if false;
      }
    }
  }
}
