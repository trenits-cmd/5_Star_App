rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(coupleId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // Eigenes Nutzerprofil: nur der Besitzer liest und schreibt es.
    // Eigenes Profil: Besitzer schreibt. Lesen erlaubt auch dem Partner im selben Paar (Anzeigename).
    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid
          || (resource.data.coupleId != null && isMember(resource.data.coupleId)));
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Einladungscodes: Einlösen durch jeden angemeldeten Nutzer, Erstellen nur für Paar-Mitglieder.
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && isMember(request.resource.data.coupleId)
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isMember(resource.data.coupleId);
      allow update: if false;
    }

    match /couples/{coupleId} {
      allow read: if isMember(coupleId);

      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];

      // Beitritt: nur wenn genau ein Mitglied vorhanden ist und man sich selbst hinzufügt.
      allow update: if isMember(coupleId)
        || (signedIn()
          && resource.data.members.size() == 1
          && request.resource.data.members.size() == 2
          && request.auth.uid in request.resource.data.members
          && resource.data.members[0] in request.resource.data.members);

      allow delete: if false;

      // Mitglieder lesen alles im Paar.
      match /categories/{catId} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId) && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if isMember(coupleId) && resource.data.ownerUid == request.auth.uid;
      }

      match /catalog/{itemId} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId) && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if isMember(coupleId) && resource.data.ownerUid == request.auth.uid;
      }

      // Tageseinträge: nur der Besitzer schreibt die eigenen Bewertungen.
      match /days/{dayId} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId) && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if false;
      }

      // Aufgaben: der Besitzer legt an und ändert nichts an der Aufgabe selbst.
      // Der Partner setzt den Status auf CONFIRMED.
      // Nach 48 Stunden darf jedes Mitglied eine offene Aufgabe auf AUTO_CONFIRMED setzen.
      match /tasks/{taskId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) && request.resource.data.ownerUid == request.auth.uid;
        allow update: if isMember(coupleId)
          && (
            (resource.data.ownerUid == request.auth.uid
              && request.resource.data.ownerUid == resource.data.ownerUid
              && request.resource.data.status == resource.data.status)
            ||
            (resource.data.ownerUid != request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && resource.data.status == 'OPEN'
              && request.resource.data.status == 'CONFIRMED')
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && resource.data.status == 'OPEN'
              && request.resource.data.status == 'AUTO_CONFIRMED'
              && request.time.toMillis() >= resource.data.createdAt.toMillis() + 172800000)
          );
        allow delete: if false;
      }
    }
  }
}
